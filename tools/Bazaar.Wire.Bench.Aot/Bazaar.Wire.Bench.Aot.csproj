<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tiny app for the S-WTX AOT size and warning count. One codec per publish (delete obj and bin between codecs): pass -p:Codec=json|cbor|msgpack|protobuf|memorypack -p:AotPublish=true.
    The app encodes and decodes one gc.message frame, so the codec and its generated code are really used and not trimmed away.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Codec Condition="'$(Codec)' == ''">json</Codec>
    <DefineConstants>$(DefineConstants);CODEC_$(Codec.ToUpperInvariant())</DefineConstants>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Bazaar.Wire.Bench.Aot</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Set here, not on the command line: a global PublishAot would also reach the netstandard2.0 generator project and fail it (NETSDK1207). -->
    <PublishAot Condition="'$(AotPublish)' == 'true'">true</PublishAot>
    <RuntimeIdentifier Condition="'$(AotPublish)' == 'true'">linux-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bazaar.Contracts\Bazaar.Contracts.csproj" />
    <ProjectReference Condition="'$(Codec)' == 'cbor'" Include="..\..\src\Bazaar.Wire.Codec.Cbor\Bazaar.Wire.Codec.Cbor.csproj" />
    <ProjectReference Condition="'$(Codec)' == 'msgpack'" Include="..\..\src\Bazaar.Wire.Codec.MessagePack\Bazaar.Wire.Codec.MessagePack.csproj" />
    <ProjectReference Condition="'$(Codec)' == 'protobuf'" Include="..\..\src\Bazaar.Wire.Codec.Protobuf\Bazaar.Wire.Codec.Protobuf.csproj" />
    <ProjectReference Condition="'$(Codec)' == 'memorypack'" Include="..\..\src\Bazaar.Wire.Codec.MemoryPack\Bazaar.Wire.Codec.MemoryPack.csproj" />
  </ItemGroup>
</Project>
