<Project Sdk="Microsoft.NET.Sdk">

  <!-- S14 spike: console benchmark for the server-side graph layout tick (doc 19 "Layout engine").
       No Avalonia dependency. Built Release. Not part of Bazaar.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>S14.Bench</AssemblyName>
    <RootNamespace>S14</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
