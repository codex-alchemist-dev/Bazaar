# Copy this file to .env (same folder) and set the password. .env is git-ignored.
# Required: the compose file refuses to start while this is empty.
# Use a long random value, for example: openssl rand -hex 24
BAZAAR_DB_PASSWORD=

# Optional: host port on 127.0.0.1 (default 5432). Change it if 5432 is already in use.
# BAZAAR_DB_PORT=5432

# Optional: PostgreSQL major version (default 19). Set 18 here, or use compose.pg18.yaml.
# PG_MAJOR=19
