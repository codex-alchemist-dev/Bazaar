#!/bin/sh
set -e

case "$1" in
  remove|upgrade|deconfigure)
    # Stop before files are replaced so the host drains turns and the process
    # exits first. systemctl waits up to TimeoutStopSec.
    if [ -d /run/systemd/system ] && systemctl is-active --quiet bazaar-server.service; then
      systemctl stop bazaar-server.service || true
    fi
    ;;
esac

#DEBHELPER#

exit 0
