# Bazaar server bootstrap configuration, read by bazaar-server.service.
# Only bootstrap values belong here. Everything else lives in the settings registry (doc 03).
# Owned root:bazaar, mode 0640.

Bazaar__Host__DataRoot=/var/lib/bazaar

# Secret reference for the database connection string. The service refuses to start until
# BAZAAR_DB is set. Add it to this file, for example:
#   BAZAAR_DB=Host=127.0.0.1;Database=bazaar;Username=bazaar;Password=<secret>
Bazaar__Host__DatabaseConnectionReference=env:BAZAAR_DB
