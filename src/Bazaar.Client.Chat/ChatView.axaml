<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chat="using:Bazaar.Client.Chat"
             xmlns:chatabs="using:Bazaar.Client.Chat.Abstractions"
             xmlns:motion="using:Bazaar.Client.Motion.Avalonia"
             x:Class="Bazaar.Client.Chat.ChatView"
             x:DataType="chat:ChatViewModel">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding Status}"
               Opacity="0.7"
               Margin="0,0,0,8" />
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="4">
      <TextBlock Text="{Binding Error}"
                 Foreground="Crimson"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel x:Name="TypingRow"
                  Orientation="Horizontal"
                  Spacing="{DynamicResource Bazaar.space.sm}"
                  IsVisible="{Binding IsTyping}"
                  AutomationProperties.Name="Typing indicator">
        <motion:TypingDots VerticalAlignment="Center" IsVisible="{Binding IsTyping}" />
        <TextBlock Text="{Binding TypingLabel}" Opacity="0.7" />
      </StackPanel>
      <DockPanel>
        <Button x:Name="SendButton"
                DockPanel.Dock="Right"
                AutomationProperties.Name="Send message"
                Content="Send"
                Margin="8,0,0,0" />
        <TextBox x:Name="DraftBox"
                 AutomationProperties.Name="Message draft"
                 Text="{Binding Draft}"
                 PlaceholderText="Type a message, Enter to send" />
      </DockPanel>
    </StackPanel>
    <ListBox x:Name="Lines"
             AutomationProperties.Name="Chat messages"
             ItemsSource="{Binding Lines}"
             Background="Transparent"
             BorderThickness="0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="chatabs:ChatLine">
          <StackPanel Margin="0,4" Spacing="2">
            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
            <chat:ReactionStrip Reactions="{Binding Reactions}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
