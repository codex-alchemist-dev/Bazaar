<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Description>Reusable conformance suite for wire codecs (doc 90 Tests). Inherit WireCodecConformance in a codec's test project.</Description>
    <IsPackable>false</IsPackable>
    <!-- A test library: public test methods have no XML docs by design. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="xunit.v3.assert" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bazaar.Contracts\Bazaar.Contracts.csproj" />
  </ItemGroup>
</Project>
