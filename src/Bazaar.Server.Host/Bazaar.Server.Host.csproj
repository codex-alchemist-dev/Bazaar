<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Server GC with DATAS (doc 40, owner decision 2026-11-11): scales heaps to load instead of one heap per core. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.DynamicAdaptationMode" Value="1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bazaar.Server\Bazaar.Server.csproj" />
    <ProjectReference Include="..\Bazaar.Components.ManagedPostgres\Bazaar.Components.ManagedPostgres.csproj" />
    <ProjectReference Include="..\Bazaar.Server.Community\Bazaar.Server.Community.csproj" />
    <ProjectReference Include="..\Bazaar.Server.Components.Backup\Bazaar.Server.Components.Backup.csproj" />
    <ProjectReference Include="..\Bazaar.Server.Components.Fun\Bazaar.Server.Components.Fun.csproj" />
    <ProjectReference Include="..\Bazaar.Server.Components.Kanban\Bazaar.Server.Components.Kanban.csproj" />
    <ProjectReference Include="..\Bazaar.Server.Providers.Windows\Bazaar.Server.Providers.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bazaar.Server.Host.Tests" />
  </ItemGroup>
</Project>
