<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bazaar.Server.Portability.Sandbox</RootNamespace>
    <!-- The LibraryImport source generator emits unsafe code for the libc kill call in the Linux provider. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bazaar.Server.Portability\Bazaar.Server.Portability.csproj" />
    <ProjectReference Include="..\Bazaar.Server.Portability.Sandbox.Abstractions\Bazaar.Server.Portability.Sandbox.Abstractions.csproj" />
    <!-- The child executable is built and copied next to this assembly, so the default HostAssemblyPath resolves. -->
    <ProjectReference Include="..\Bazaar.Server.Portability.ParserHost\Bazaar.Server.Portability.ParserHost.csproj" />
  </ItemGroup>
</Project>
