<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Client: workstation concurrent GC with TieredPGO (doc 40, owner decision 2026-11-11). Latency mode is set at start-up. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' != ''">
    <!-- Publish-only precompilation for the GUI head (doc 40). Needs a RID; ignored by plain builds. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Wayland" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bazaar.Client.Preload\Bazaar.Client.Preload.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Launcher\Bazaar.Client.Launcher.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Chat\Bazaar.Client.Chat.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Core\Bazaar.Client.Core.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Shell\Bazaar.Client.Shell.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Settings\Bazaar.Client.Settings.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Materials\Bazaar.Client.Materials.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Theme\Bazaar.Client.Theme.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Posture\Bazaar.Client.Posture.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Motion.Avalonia\Bazaar.Client.Motion.Avalonia.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Components.Launcher\Bazaar.Client.Components.Launcher.csproj" />
  </ItemGroup>
</Project>
