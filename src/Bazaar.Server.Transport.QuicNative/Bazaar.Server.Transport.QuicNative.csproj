<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Description>Native QUIC wire transport "quic", Server side (doc 90 section 9): System.Net.Quic, ALPN bazaar-wire/1, no HTTP.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- System.Net.Quic is annotated for linux, macos and windows only. Every entry point checks IsSupported first and the
         module drops out of negotiation elsewhere (doc 90 section 9), so the platform analyzer would only add noise. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bazaar.Wire.Abstractions\Bazaar.Wire.Abstractions.csproj" />
  </ItemGroup>
</Project>
