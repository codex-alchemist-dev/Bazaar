<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Description>CBOR (RFC 8949) wire codec, name "cbor" (doc 90). System.Formats.Cbor from the BCL; serialisation code is generated, no reflection.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bazaar.Contracts\Bazaar.Contracts.csproj" />
    <ProjectReference Include="..\Bazaar.Wire.Generators\Bazaar.Wire.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Formats.Cbor" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bazaar.Wire.Codec.Cbor.Tests" />
  </ItemGroup>
</Project>
