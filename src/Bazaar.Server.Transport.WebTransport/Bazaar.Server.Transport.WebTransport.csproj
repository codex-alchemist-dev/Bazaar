<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Description>WebTransport wire transport "webtransport", Server side (doc 90 section 9): HTTP/3 extended CONNECT on /wt. Experimental, off by default.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The Kestrel WebTransport API is preview-gated in .NET 11 (doc 90 section 9, spike S-WTX). -->
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Bazaar.Wire.Abstractions\Bazaar.Wire.Abstractions.csproj" />
  </ItemGroup>
</Project>
