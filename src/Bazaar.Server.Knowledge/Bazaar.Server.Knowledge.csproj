<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Bazaar.Server.Knowledge</RootNamespace>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <Nullable>enable</Nullable>
    <!-- DecisionRecordReader uses YamlDotNet's reflection-based DeserializerBuilder (as the Vault parser does), so this project is not AOT-compatible. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <ProjectReference Include="..\Bazaar.Server.Vault\Bazaar.Server.Vault.csproj" />
    <ProjectReference Include="..\Bazaar.Server.Knowledge.Abstractions\Bazaar.Server.Knowledge.Abstractions.csproj" />
    <ProjectReference Include="..\Bazaar.Contracts\Bazaar.Contracts.csproj" />
  </ItemGroup>
</Project>
