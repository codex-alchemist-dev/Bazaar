<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Bazaar.Server.Security</RootNamespace>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <!-- The hand-over constructor (AcceptedHandover.Create) stays internal; only the validator in the implementation may build one. -->
    <InternalsVisibleTo Include="Bazaar.Server.Security" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bazaar.Audit.Abstractions\Bazaar.Audit.Abstractions.csproj" />
    <ProjectReference Include="..\Bazaar.Approvals.Abstractions\Bazaar.Approvals.Abstractions.csproj" />
  </ItemGroup>
</Project>
