<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Description>Cronet binding adapter for the Android HTTP/3 transport (doc 90 section 9). Turns the callback-style Java Cronet BidirectionalStream, behind the small IJavaCronetBridge, into ICronetEngine and ICronetBidirectionalStream. Platform-neutral so it builds and tests without the Android workload; the thin net11.0-android head that implements IJavaCronetBridge is a separate, not yet built, piece.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bazaar.Client.Transport.AndroidHttp3\Bazaar.Client.Transport.AndroidHttp3.csproj" />
    <ProjectReference Include="..\Bazaar.Wire.Abstractions\Bazaar.Wire.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bazaar.Client.Transport.AndroidHttp3.Android.Tests" />
  </ItemGroup>
</Project>
