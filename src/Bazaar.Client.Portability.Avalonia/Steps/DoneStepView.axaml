<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wiz="using:Bazaar.Client.Portability.Avalonia"
             x:Class="Bazaar.Client.Portability.Avalonia.DoneStepView"
             x:DataType="wiz:WizardViewModel">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="Import done" FontSize="18" FontWeight="Bold" />
    <TextBlock Text="{Binding State.Commit.Written, StringFormat='Records written: {0}'}" />
  </StackPanel>
</UserControl>
