# Template for /etc/systemd/system/bazaar-volume.service (doc 63 section 4).
# The privileged volume unit: opens the LUKS2 data volume before the host starts and closes it after the host stops.
# Installed by setup; adjust the executable path to the install location.
[Unit]
Description=Bazaar encrypted data volume
Documentation=https://github.com/codex-alchemist-dev/Bazaar/blob/main/docs/design/63-encrypted-data-folder.md
After=local-fs.target
Before=bazaar.service

[Service]
Type=oneshot
# The mapping and the mount outlive the open command; stop runs the close command.
RemainAfterExit=yes
ExecStart=/usr/local/bin/bazaar-server volume open
# close fails while any process still has files open under the data root. There is no forced unmount.
ExecStop=/usr/local/bin/bazaar-server volume close
User=root

# Hardening that applies. The unit needs no network (the key comes from the local KEK provider).
PrivateNetwork=yes
ProtectHome=yes
# AF_UNIX only. libcryptsetup talks to udev; if a host needs AF_NETLINK for that, add it after testing on that host.
RestrictAddressFamilies=AF_UNIX

# Hardening that must NOT be set, and why:
# - NoNewPrivileges=: not usable here. mount, cryptsetup and losetup run as root and may call setuid or file-capability helpers.
# - PrivateMounts=, ProtectSystem=strict, PrivateDevices=, PrivateTmp=: each puts the unit in its own mount namespace or
#   hides /dev, so the data volume mount would be invisible to bazaar.service, or /dev/mapper/control unreachable.

[Install]
RequiredBy=bazaar.service
WantedBy=multi-user.target
