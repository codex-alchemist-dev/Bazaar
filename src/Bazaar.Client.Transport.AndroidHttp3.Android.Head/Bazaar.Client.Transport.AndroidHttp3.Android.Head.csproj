<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Thin Android head for the Cronet bridge (doc 90 section 9). It implements IJavaCronetBridge over the real Java Cronet API
    (org.chromium.net:cronet-embedded, bound at build time from Google's Maven repository).

    Same pattern as Bazaar.Client.Android: without BazaarAndroid=true this project is a plain net11.0 library holding only the
    platform-neutral logic (network-event tracker, header and failure mapping), so restore and build succeed on hosts without
    the Android workload (Linux CI, GitHub's dependency submission, which fails a net11.0-android restore with NETSDK1147).
    With BazaarAndroid=true it targets net11.0-android and adds the Cronet binding and AndroidCronetBridge. Build that on a
    machine with the workload and the Android SDK: dotnet build <this project> -p:BazaarAndroid=true
  -->
  <PropertyGroup>
    <BazaarAndroid Condition="'$(BazaarAndroid)' == ''">false</BazaarAndroid>
    <Description>Android head for the Cronet transport: implements IJavaCronetBridge over the embedded Java Cronet library (doc 90 section 9).</Description>
    <RootNamespace>Bazaar.Client.Transport.AndroidHttp3.Android.Head</RootNamespace>
    <!-- Newest non-deprecated cronet-embedded on Google Maven. The 500.x cronet-embedded artifacts are deprecated stubs that redirect to cronet-bundled. -->
    <CronetVersion>143.7445.0</CronetVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BazaarAndroid)' == 'true'">
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>35</SupportedOSPlatformVersion>
    <TargetPlatformVersion>37.0</TargetPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BazaarAndroid)' != 'true'">
    <TargetFramework>net11.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bazaar.Client.Transport.AndroidHttp3\Bazaar.Client.Transport.AndroidHttp3.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Transport.AndroidHttp3.Android\Bazaar.Client.Transport.AndroidHttp3.Android.csproj" />
    <ProjectReference Include="..\Bazaar.Wire.Abstractions\Bazaar.Wire.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(BazaarAndroid)' == 'true'">
    <AndroidMavenLibrary Include="org.chromium.net:cronet-embedded" Version="$(CronetVersion)" Repository="Google" />
  </ItemGroup>
  <ItemGroup Condition="'$(BazaarAndroid)' != 'true'">
    <Compile Remove="Android\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bazaar.Client.Transport.AndroidHttp3.Android.Head.Tests" />
  </ItemGroup>
</Project>
