<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Android head (doc 29). Not in Bazaar.slnx: the Android workload is not on the hosted CI runners.
    Build it with scripts/build-android.sh (passes BazaarAndroid=true) on a machine with the workload and the Android SDK.

    Without BazaarAndroid=true this project targets plain net11.0 with no Android packages, so restore
    succeeds on hosts without the workload. GitHub's automatic dependency submission (the "submit-nuget"
    check) restores every project it finds, and a net11.0-android restore fails there with NETSDK1147.
  -->
  <PropertyGroup>
    <BazaarAndroid Condition="'$(BazaarAndroid)' == ''">false</BazaarAndroid>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BazaarAndroid)' == 'true'">
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>35</SupportedOSPlatformVersion>
    <!-- Target API 37 (Android 17), pinned explicitly so a newer installed platform does not change the manifest targetSdkVersion silently (#423). -->
    <TargetPlatformVersion>37.0</TargetPlatformVersion>
    <ApplicationId>org.bazaar.client</ApplicationId>
    <ApplicationTitle>Bazaar</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <RootNamespace>Bazaar.Client.Android</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BazaarAndroid)' != 'true'">
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Bazaar.Client.Android</RootNamespace>
  </PropertyGroup>
  <ItemGroup Condition="'$(BazaarAndroid)' == 'true'">
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- Approval biometric prompt (doc 29, Approvals): AndroidX BiometricPrompt, newest stable binding. -->
    <PackageReference Include="Xamarin.AndroidX.Biometric" />
    <!-- No direct Xamarin.AndroidX.Window reference. Its 1.5.1.3 pulls Core 1.19 (Lifecycle 2.11) against the Lifecycle 2.10 pins
         from Activity and Fragment (NU1608). Avalonia.Android brings Window 1.5.1.2 transitively, which resolves cleanly. -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bazaar.Client.Annotation\Bazaar.Client.Annotation.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Approvals\Bazaar.Client.Approvals.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Approvals.Avalonia\Bazaar.Client.Approvals.Avalonia.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Approvals.Http\Bazaar.Client.Approvals.Http.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Approvals.Phone\Bazaar.Client.Approvals.Phone.csproj" />
    <ProjectReference Include="..\Bazaar.Client.TalentPool.Http\Bazaar.Client.TalentPool.Http.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Constellation\Bazaar.Client.Constellation.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Views\Bazaar.Client.Views.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Navigation\Bazaar.Client.Navigation.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Preferences\Bazaar.Client.Preferences.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Core\Bazaar.Client.Core.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Shell\Bazaar.Client.Shell.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Mobile\Bazaar.Client.Mobile.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Dashboard\Bazaar.Client.Dashboard.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Gc\Bazaar.Client.Gc.csproj" />
    <ProjectReference Include="..\..\src\Bazaar.Client.Vault\Bazaar.Client.Vault.csproj" />
    <ProjectReference Include="..\..\src\Bazaar.Client.Engines\Bazaar.Client.Engines.csproj" />
    <ProjectReference Include="..\Bazaar.Client.RyuseiFuda\Bazaar.Client.RyuseiFuda.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Org\Bazaar.Client.Org.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Calendar\Bazaar.Client.Calendar.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Interrupts\Bazaar.Client.Interrupts.csproj" />
    <ProjectReference Include="..\Bazaar.Client.GitSolarSystem\Bazaar.Client.GitSolarSystem.csproj" />
