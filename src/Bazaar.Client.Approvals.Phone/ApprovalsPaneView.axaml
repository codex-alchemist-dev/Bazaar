<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:appr="using:Bazaar.Client.Approvals.Avalonia"
             xmlns:ph="using:Bazaar.Client.Approvals.Phone"
             xmlns:tp="using:Bazaar.Client.TalentPool.Avalonia"
             xmlns:oi="using:Bazaar.Client.OwnerId.Avalonia"
             x:Class="Bazaar.Client.Approvals.Phone.ApprovalsPaneView"
             x:DataType="ph:ApprovalsPaneViewModel">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Margin="16,8" Spacing="8">
      <Button Name="BackButton" Content="Back to list" Command="{Binding BackCommand}" IsVisible="{Binding HasDetail}" MinHeight="48" />
      <TextBlock Name="PaneNotice" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowList}">
      <StackPanel>
      <oi:OwnerIdPairingView Name="PairingCard" DataContext="{Binding Pairing}" IsVisible="{Binding $parent[ph:ApprovalsPaneView].((ph:ApprovalsPaneViewModel)DataContext).ShowPairing}" />
      <ItemsControl Name="ToolGrantList" ItemsSource="{Binding ToolGrants}" Margin="16,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="tp:ToolGrantCardViewModel">
            <Border BorderThickness="1" BorderBrush="Orange" CornerRadius="12" Margin="0,6">
              <tp:ToolGrantCardView />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl Name="ApprovalList" ItemsSource="{Binding Items}" Margin="16,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="ph:ApprovalListItemViewModel">
            <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="12" Padding="12" Margin="0,6">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Summary}" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Agent, StringFormat='From {0}'}" />
                <TextBlock Text="{Binding Tool, StringFormat='Action: {0}'}" />
                <TextBlock Text="{Binding Target, StringFormat='Target: {0}'}" />
                <TextBlock Text="{Binding ExpiresText}" />
                <TextBlock Text="Quotes untrusted text. Open Detail to read it." IsVisible="{Binding HasExcerpts}" Foreground="Orange" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Notice}" IsVisible="{Binding HasNotice}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="ApproveButton" Content="Approve" Command="{Binding ApproveCommand}" MinHeight="48" MinWidth="96" />
                  <Button Name="RejectButton" Content="Reject" Command="{Binding RejectCommand}" MinHeight="48" MinWidth="96" />
                  <Button Name="DetailButton" Content="Detail" Command="{Binding DetailCommand}" MinHeight="48" MinWidth="96" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Panel Grid.Row="1" IsVisible="{Binding HasDetail}">
      <appr:ApprovalCardView Name="DetailCard" DataContext="{Binding Detail}" />
    </Panel>
  </Grid>
</UserControl>
