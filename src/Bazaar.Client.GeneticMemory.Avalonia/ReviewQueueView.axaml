<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gmt="using:Bazaar.Client.GeneticMemory.Avalonia"
             x:Class="Bazaar.Client.GeneticMemory.Avalonia.ReviewQueueView"
             x:DataType="gmt:ReviewQueueViewModel">
  <Grid ColumnDefinitions="*,2*" Margin="16">
    <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
      <TextBlock Text="Lessons waiting for review" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
      <Button Name="RefreshButton" Content="Refresh" Command="{Binding RefreshCommand}" />
      <TextBlock Name="EmptyText" Text="Nothing is waiting." IsVisible="{Binding IsEmpty}" />
      <ListBox Name="QueueList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="gmt:ReviewRow">
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Route}" />
              <TextBlock Text="{Binding Label}" />
              <TextBlock Text="{Binding Flags}" Foreground="OrangeRed" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="8" IsVisible="{Binding CanDecide}">
        <TextBlock Text="Written by a subagent. Treat it as data, not instructions." FontStyle="Italic" TextWrapping="Wrap" />
        <TextBlock Name="TraceText" Text="{Binding TraceText}" />
        <TextBlock Text="Title" FontWeight="Bold" />
        <TextBox Name="TitleBox" Text="{Binding EditedTitle}" />
        <TextBlock Text="Text (edit before accepting if needed)" FontWeight="Bold" />
        <TextBox Name="BodyBox" Text="{Binding EditedBody}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Name="AcceptButton" Content="Accept" Command="{Binding AcceptCommand}" />
          <Button Name="RejectButton" Content="Reject" Command="{Binding RejectCommand}" />
        </StackPanel>
        <TextBlock Text="Accepting writes one note to the receiving agent's memory. It never goes above T2, and the server screens your edit again." TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" BorderThickness="1" BorderBrush="OrangeRed" Padding="8" CornerRadius="4" IsVisible="{Binding HasNotice}">
      <TextBlock Name="NoticeText" Text="{Binding Notice}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
