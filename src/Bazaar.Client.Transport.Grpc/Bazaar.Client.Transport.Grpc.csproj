<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Description>gRPC wire transport, client half (doc 90 section 9). Grpc.Net.Client over HTTP/2, and HTTP/3 where the platform has it.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bazaar.Wire.Abstractions\Bazaar.Wire.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <Protobuf Include="Protos\session.proto" GrpcServices="Client" Access="Internal" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bazaar.Transport.Grpc.Tests" />
  </ItemGroup>
</Project>
