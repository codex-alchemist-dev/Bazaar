<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <!-- Working name of the program (doc 58, names provisional). -->
    <AssemblyName>bazaar-tui</AssemblyName>
    <RootNamespace>Bazaar.Client.Tui.Host</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bazaar.Client.Tui.Host.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bazaar.Core\Bazaar.Core.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Tui.Abstractions\Bazaar.Client.Tui.Abstractions.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Tui\Bazaar.Client.Tui.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Tui.Installer\Bazaar.Client.Tui.Installer.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Tui.Dashboard\Bazaar.Client.Tui.Dashboard.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Tui.Dashboard.Abstractions\Bazaar.Client.Tui.Dashboard.Abstractions.csproj" />
    <ProjectReference Include="..\Bazaar.Server.OpsPorts\Bazaar.Server.OpsPorts.csproj" />
    <ProjectReference Include="..\Bazaar.Server.SignIn.Postgres\Bazaar.Server.SignIn.Postgres.csproj" />
    <ProjectReference Include="..\Bazaar.Server.SignIn.Abstractions\Bazaar.Server.SignIn.Abstractions.csproj" />
    <ProjectReference Include="..\Bazaar.Server.WebAdmin\Bazaar.Server.WebAdmin.csproj" />
    <ProjectReference Include="..\Bazaar.Server.WebAdmin.Abstractions\Bazaar.Server.WebAdmin.Abstractions.csproj" />
    <ProjectReference Include="..\Bazaar.Roles\Bazaar.Roles.csproj" />
    <ProjectReference Include="..\Bazaar.Roles.Abstractions\Bazaar.Roles.Abstractions.csproj" />
    <ProjectReference Include="..\Bazaar.Audit.Abstractions\Bazaar.Audit.Abstractions.csproj" />
    <ProjectReference Include="..\Bazaar.Server.Setup.Abstractions\Bazaar.Server.Setup.Abstractions.csproj" />
    <!--
      The setup apply pieces (the Postgres apply gate, the plain console prompter, the settings catalogue) live once, in bazaar-admin
      and the setup host. This program reuses them instead of copying them (doc 58: "no wizard logic of its own"). They reach Bazaar.Server
      only through those two projects; this project has no direct reference to Bazaar.Server.
    -->
    <ProjectReference Include="..\Bazaar.Admin\Bazaar.Admin.csproj" />
    <ProjectReference Include="..\Bazaar.Server.Setup.Host\Bazaar.Server.Setup.Host.csproj" />
    <ProjectReference Include="..\Bazaar.Server.Setup\Bazaar.Server.Setup.csproj" />
  </ItemGroup>
</Project>
