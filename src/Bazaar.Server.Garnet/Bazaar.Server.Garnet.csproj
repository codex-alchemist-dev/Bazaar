<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <RootNamespace>Bazaar.Server.Garnet</RootNamespace>
    <!-- The Windows Job object calls (WindowsJobObject.cs) use LibraryImport, whose generated stubs are unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bazaar.Server.Garnet.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bazaar.Core\Bazaar.Core.csproj" />
    <ProjectReference Include="..\Bazaar.Core.Hosting\Bazaar.Core.Hosting.csproj" />
    <ProjectReference Include="..\Bazaar.Secrets.Abstractions\Bazaar.Secrets.Abstractions.csproj" />
    <ProjectReference Include="..\Bazaar.Server.Providers.Abstractions\Bazaar.Server.Providers.Abstractions.csproj" />
    <ProjectReference Include="..\Bazaar.Server.Valkey.Abstractions\Bazaar.Server.Valkey.Abstractions.csproj" />
  </ItemGroup>
</Project>
