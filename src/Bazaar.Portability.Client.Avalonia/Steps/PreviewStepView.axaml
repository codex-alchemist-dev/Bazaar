<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wiz="using:Bazaar.Portability.Client.Avalonia"
             xmlns:pc="using:Bazaar.Portability.Client"
             xmlns:portability="using:Bazaar.Portability"
             x:Class="Bazaar.Portability.Client.Avalonia.PreviewStepView"
             x:DataType="wiz:WizardViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">
      <TextBlock Text="Preview" FontSize="18" FontWeight="Bold" />

      <!-- Counts -->
      <StackPanel Orientation="Horizontal" Spacing="24">
        <TextBlock Text="{Binding State.Preview.NewCount, StringFormat='New: {0}'}" />
        <TextBlock Text="{Binding State.Preview.DuplicateCount, StringFormat='Already imported: {0}'}" />
      </StackPanel>

      <!-- Samples, per target -->
      <TextBlock Text="Samples by target" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding State.Preview.Targets}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="pc:TargetPreview">
            <StackPanel Margin="0,4" Spacing="2">
              <TextBlock Text="{Binding Target}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Count, StringFormat='{}{0} records'}" Opacity="0.7" />
              <ItemsControl ItemsSource="{Binding Samples}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="portability:SourceRecord">
                    <TextBlock Text="{Binding Title}" Margin="12,0,0,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Collisions: two or more new records share a target and title; the user picks the one to keep -->
      <TextBlock Text="Collisions" FontWeight="SemiBold" />
      <TextBlock Text="Two or more new records share a target and title. Choose the one to keep." TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Collisions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="wiz:CollisionChoice">
            <Border Padding="8" Margin="0,4" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Target}" Opacity="0.7" />
                <TextBlock Text="Keep" />
                <ComboBox ItemsSource="{Binding SourceKeys}"
                          SelectedItem="{Binding SelectedKey, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Unmapped: new records the mapping cannot place -->
      <TextBlock Text="Unmapped items" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding State.Preview.Unmapped}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="pc:UnmappedItem">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding SourceKey}" />
              <TextBlock Text="{Binding Reason}" Opacity="0.7" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button Content="Run dry-run" Command="{Binding DryRunCommand}" HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
