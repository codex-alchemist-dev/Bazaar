<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wiz="using:Bazaar.Portability.Client.Avalonia"
             x:Class="Bazaar.Portability.Client.Avalonia.DryRunStepView"
             x:DataType="wiz:WizardViewModel">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="Dry-run" FontSize="18" FontWeight="Bold" />
    <TextBlock Text="Running the import against a scratch target. Nothing is written yet." TextWrapping="Wrap"
               IsVisible="{Binding IsDryRunPending}" />
    <StackPanel Spacing="4" IsVisible="{Binding HasDryRunReport}">
      <TextBlock Text="{Binding State.DryRun.WouldWrite, StringFormat='Would write: {0}'}" />
      <TextBlock Text="{Binding State.DryRun.WouldConflict, StringFormat='Would conflict: {0}'}" />
      <TextBlock Text="{Binding State.DryRun.Message}" TextWrapping="Wrap" />
    </StackPanel>
    <!-- CanExecute on CommitCommand disables this until the dry-run matches the current mapping. -->
    <Button Content="Commit" AutomationProperties.Name="Commit import" Command="{Binding CommitCommand}" HorizontalAlignment="Left" />
  </StackPanel>
</UserControl>
