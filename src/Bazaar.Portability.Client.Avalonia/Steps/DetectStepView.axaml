<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wiz="using:Bazaar.Portability.Client.Avalonia"
             x:Class="Bazaar.Portability.Client.Avalonia.DetectStepView"
             x:DataType="wiz:WizardViewModel">
  <StackPanel Margin="16" Spacing="8">
    <TextBlock Text="More than one importer can read this source" FontSize="18" FontWeight="Bold" />
    <TextBlock Text="Choose the importer to use. Each one shows how sure it is and why." TextWrapping="Wrap" />
    <ItemsControl ItemsSource="{Binding Candidates}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="wiz:CandidateChoice">
          <Border Padding="8" Margin="0,4" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Confidence, StringFormat='Confidence {0}'}" />
              <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
              <Button Content="Use this importer" AutomationProperties.Name="{Binding Id, StringFormat='Use importer {0}'}" Command="{Binding ChooseCommand}" CommandParameter="{Binding Id}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
