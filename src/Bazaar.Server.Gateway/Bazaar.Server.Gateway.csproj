<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Bazaar.Server.Gateway</RootNamespace>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <!-- Module migrations: Data/Sql/<namespace>/NNNN_name.sql, read by EmbeddedMigrationSource (see Data/Sql/README.md). -->
    <EmbeddedResource Include="Data\Sql\**\*.sql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bazaar.Contracts\Bazaar.Contracts.csproj" />
    <ProjectReference Include="..\Bazaar.Core.Hosting\Bazaar.Core.Hosting.csproj" />
    <ProjectReference Include="..\Bazaar.Secrets.Abstractions\Bazaar.Secrets.Abstractions.csproj" />
    <ProjectReference Include="..\Bazaar.Server.Gateway.Abstractions\Bazaar.Server.Gateway.Abstractions.csproj" />
    <ProjectReference Include="..\Bazaar.Server.Gateway.Selection.Abstractions\Bazaar.Server.Gateway.Selection.Abstractions.csproj" />
    <ProjectReference Include="..\Bazaar.Server.Settings.Abstractions\Bazaar.Server.Settings.Abstractions.csproj" />
  </ItemGroup>
</Project>
