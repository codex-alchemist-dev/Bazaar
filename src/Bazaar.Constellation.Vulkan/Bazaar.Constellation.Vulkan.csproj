<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Vortice.Vulkan" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bazaar.Constellation.Vulkan.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Shaders\*.glsl" />
    <EmbeddedResource Include="Shaders\*.spv" LogicalName="Bazaar.Constellation.Vulkan.Shaders.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bazaar.Constellation.Rendering\Bazaar.Constellation.Rendering.csproj" />
  </ItemGroup>
</Project>
