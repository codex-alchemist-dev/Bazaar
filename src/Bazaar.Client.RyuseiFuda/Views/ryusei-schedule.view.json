{
  "dslVersion": 1,
  "name": "bazaar.ryusei.schedule",
  "data": {
    "triggers": {
      "capability": "ryusei.schedule",
      "type": "list",
      "fields": {
        "id": "text",
        "summary": "text",
        "purpose": "text",
        "detail": "text",
        "canPause": "bool",
        "canResume": "bool"
      }
    },
    "emptyText": { "capability": "ryusei.schedule", "type": "text" },
    "emptyVisible": { "capability": "ryusei.schedule", "type": "bool" },
    "errorText": { "capability": "ryusei.schedule", "type": "text" },
    "errorVisible": { "capability": "ryusei.schedule", "type": "bool" }
  },
  "actions": {
    "pause": { "kind": "invoke", "target": "ryusei.trigger.pause" },
    "resume": { "kind": "invoke", "target": "ryusei.trigger.resume" }
  },
  "root": {
    "widget": "stack",
    "children": [
      { "widget": "text", "props": { "text": { "expr": "emptyText" }, "style": "small", "visibleWhen": { "expr": "emptyVisible" } } },
      { "widget": "text", "props": { "text": { "expr": "errorText" }, "style": "small", "visibleWhen": { "expr": "errorVisible" } } },
      {
        "widget": "list",
        "props": { "over": "triggers", "key": "id" },
        "children": [
          {
            "widget": "stack",
            "children": [
              { "widget": "text", "props": { "text": { "expr": "summary" } } },
              { "widget": "text", "props": { "text": { "expr": "purpose" } } },
              { "widget": "text", "props": { "text": { "expr": "detail" }, "style": "small" } },
              {
                "widget": "button",
                "props": {
                  "label": "Pause",
                  "action": "pause",
                  "args": { "id": { "expr": "id" } },
                  "visibleWhen": { "expr": "canPause" }
                }
              },
              {
                "widget": "button",
                "props": {
                  "label": "Resume",
                  "action": "resume",
                  "args": { "id": { "expr": "id" } },
                  "visibleWhen": { "expr": "canResume" }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
