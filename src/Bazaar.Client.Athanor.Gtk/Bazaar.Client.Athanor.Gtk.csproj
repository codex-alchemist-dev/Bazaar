<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Bazaar.Client.Athanor.Gtk</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The helper's control protocol is one source file shared by both sides, so they cannot drift (doc 57 section 2.1). -->
    <Compile Include="..\Bazaar.Client.Athanor.Gtk.Helper\HelperProtocol.cs" Link="Protocol\HelperProtocol.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bazaar.Client.Athanor.Abstractions\Bazaar.Client.Athanor.Abstractions.csproj" />
    <ProjectReference Include="..\Bazaar.Client.Athanor\Bazaar.Client.Athanor.csproj" />
  </ItemGroup>
</Project>
