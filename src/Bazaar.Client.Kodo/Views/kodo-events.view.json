{
  "dslVersion": 1,
  "name": "bazaar.kodo.events",
  "data": {
    "events": {
      "capability": "kodo.events",
      "type": "list",
      "fields": {
        "id": "text",
        "kind": "text",
        "summary": "text",
        "when": "text",
        "position": "text"
      }
    },
    "emptyText": { "capability": "kodo.events", "type": "text" },
    "emptyVisible": { "capability": "kodo.events", "type": "bool" }
  },
  "actions": {
    "proof": { "kind": "invoke", "target": "kodo.journal.proof" }
  },
  "root": {
    "widget": "stack",
    "children": [
      { "widget": "text", "props": { "value": { "expr": "emptyText" }, "style": "small", "visibleWhen": { "expr": "emptyVisible" } } },
      {
        "widget": "list",
        "props": { "over": "events", "key": "id" },
        "children": [
          {
            "widget": "row",
            "children": [
              { "widget": "badge", "props": { "value": { "expr": "kind" }, "variant": "system" } },
              { "widget": "text", "props": { "value": { "expr": "summary" } } },
              { "widget": "text", "props": { "value": { "expr": "when" }, "style": "small" } },
              { "widget": "text", "props": { "value": { "expr": "position" }, "style": "small" } },
              {
                "widget": "button",
                "props": {
                  "label": "Merkle proof",
                  "action": "proof",
                  "args": { "id": { "expr": "id" } }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
