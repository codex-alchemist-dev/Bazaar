# Normalise text files to LF in the repository; check out as LF by default.
* text=auto eol=lf

# Windows-native scripts and solution files keep CRLF line endings.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sln text eol=crlf

# Binary assets: never diff, merge or normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.dll binary
*.exe binary

# Count the design docs and research as documentation in language statistics.
docs/** linguist-documentation
docs/research/notes/** linguist-documentation
docs/research/reports/** linguist-documentation
