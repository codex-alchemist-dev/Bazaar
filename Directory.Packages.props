<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <!-- Core only (no WinForms or WPF controls); hosts the Athanor editor island (doc 57 §3a). Same pin as spike S12. -->
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Wayland" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Android" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.HarfBuzz" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="11.0.0" />
    <!-- Host options (doc 03 WP1) and bootstrap secrets (WP3): library-side Options, DI, logging and hosted-service abstractions. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
    <!-- Windows provider module (doc 03 WP8): DPAPI bootstrap resolver and Event Log writer. Compiles everywhere; calls are guarded. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageVersion Include="System.Diagnostics.EventLog" Version="11.0.0" />
    <!-- Windows client updater (doc 28, Client updater): Velopack, newest stable on nuget.org (2026-11-22). Behind IVelopackAdapter. -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <!-- Vault Markdown (doc 18, VLT1): Markdig pipeline and YAML front matter reader. -->
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- Vault git engine (doc 18 C12, spike S23): native libgit2 ships in the package. -->
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
    <!-- Cache provider (doc 03 WP12): StackExchange.Redis 3.4.5 (stable, published 2026-10-13) talks to Valkey on Linux. Behind IValkeyClient. -->
    <PackageVersion Include="StackExchange.Redis" Version="3.4.35" />
    <!-- Wave 0 pins (docs/implementation-plan.md): data layer, test support, AI abstractions. -->
    <PackageVersion Include="MimeKit" Version="5.0.0" />
    <PackageVersion Include="MailKit" Version="5.0.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <!-- Constellation Vulkan backend (doc 19, WP7; owner direction 2026-10-30). Published 2026-09-29. -->
    <PackageVersion Include="Vortice.Vulkan" Version="3.3.0" />
    <!-- 3.2.x, not 4.0.x: Avalonia.Headless.XUnit 12.1.4 is binary-incompatible with xunit.v3 4.0.2 (MissingMethodException at discovery). -->
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <!-- Library-side xUnit v3 for module contract base classes (doc 46 section 10.3). Same version as the test host. -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
    <!-- Passphrase KDF for encrypted export bundles (doc 44 section 5): Argon2id, RFC 9106. Vetted 2026-11-15: MIT (Keef Aragon),
         source github.com/kmaragon/Konscious.Security.Cryptography, sha512 6301179dbd560b3f4ed8b81acc0e65851d2c60a6c4c5552edd058a36c915d1615d2dc6a8a1e65d987da02d8fac8409aa592d74e7ff05e510db112a793ac74ea7.
         Only transitive dependency on net8+: Konscious.Security.Cryptography.Blake2 1.1.1 (MIT, same author, sha512 b05af3d189f4748bb0680fc403f9e94ef1be678085995cdfe12598fd7d07d82381be301ce4ef7af6d76e8e648f89e430fc4e7e0563a69caaa0870a7d944fd897).
         Output is checked against an independent reference (argon2-cffi, PHC C implementation) in ExportBundleCryptoTests. -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- Local Co-Worker CPU tier (doc 31 WP5): ONNX Runtime CPU execution provider, latest stable. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <!-- Android fold posture (doc 29, WP2): Jetpack WindowManager bindings. Pinned, not yet referenced; the mapping in Bazaar.Client.Core is pure. Provisional, pending spike S13. -->
    <PackageVersion Include="Xamarin.AndroidX.Window" Version="1.5.1.3" />
    <!-- CBOR codec (doc 90 WP2): RFC 8949 reader and writer from the .NET team. A package, not part of the shared framework, even on .NET 11. -->
    <PackageVersion Include="System.Formats.Cbor" Version="11.0.0" />
    <!-- MessagePack codec (doc 90 WP3): only the low-level MessagePackReader and MessagePackWriter are used, called from generated code. No resolvers, no typeless mode. -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <!-- Wire codec generator (doc 90 WP1): build-time Roslyn only, netstandard2.0 analyzer. 4.14 runs inside every current SDK. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- Reusable codec conformance suite (doc 90 WP1): xunit v3 extensibility and assert, for a library of tests. Same version as xunit.v3.mtp-v2. -->
    <!-- gRPC and gRPC-Web transport modules (doc 90 section 9): Grpc.Tools is allowed in those two modules only. Newest stable as of 2026-11-20. -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageVersion Include="Grpc.AspNetCore.Web" Version="2.85.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageVersion Include="Grpc.Net.Client.Web" Version="2.85.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <!-- Protobuf codec (doc 90 WP2): Google.Protobuf runtime and the Grpc.Tools protoc build step. Only Bazaar.Wire.Codec.Protobuf (and later the gRPC module) may reference them; newest stable on 2026-11-20. -->
    <!-- MemoryPack codec (doc 90 WP3): the runtime for the module, the full package (with its source generator) for the layout cross-check in the tests. 1.22.0 published 2026-11-11, MIT. -->
    <PackageVersion Include="MemoryPack.Core" Version="1.22.0" />
    <PackageVersion Include="MemoryPack" Version="1.22.0" />
  </ItemGroup>
</Project>
