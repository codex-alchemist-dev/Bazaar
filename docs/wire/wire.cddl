; Bazaar wire payloads for the CBOR codec, protocol 1.0 (RFC 8610).
; Schema hash sha256:cfa96d21efb577f6a1582d933eb298fa2dcf83e293ad2df1e01fd7a32000bf06.
; Map keys are text. Absent keys mean null or the default. Readers ignore unknown keys. Generated; do not edit.

envelope = {
  v: uint,
  t: tstr,
  k: "req" / "res" / "evt" / "err",
  ? id: tstr,
  ? re: tstr,
  ? s: tstr,
  ? n: int,
  ? ts: #6.0(tstr),
  ? p: any,
  * tstr => any
}

uuid-text = tstr .regexp "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
decimal-fraction = #6.4([exponent: int, mantissa: int])
float32-array = #6.85(bstr)

; Message types and the payload rule each carries.
; board.assign = kanban-assign-request
; board.snapshot = kanban-board-request
; gc.edit = gc-edit
; gc.history = gc-history
; gc.member.add = gc-member-add
; gc.member.remove = gc-member-remove
; gc.message = wire-gc-message
; gc.read = gc-read
; gc.send = gc-send
; graph.lod = graph-lod-frame
; hello = hello
; lagged = lagged
; pane.frame = pane-frame
; ping = ping
; pong = pong
; resync = resync
; ryusei.trigger.list = ryusei-trigger-list-request
; ryusei.trigger.pause = ryusei-trigger-change-request
; ryusei.trigger.resume = ryusei-trigger-change-request
; stream.revoked = stream-revoked
; subscribe = subscribe
; unsubscribe = unsubscribe
; welcome = welcome

payload = cluster-glyph / focus-request / graph-lod-frame / graph-snapshot / layout-frame / tile-frame / tile-key / viewport-request / kanban-assign-reply / kanban-assign-request / kanban-board-request / kanban-board-snapshot / release-manifest / roadmap-board-snapshot / ryusei-trigger-change-reply / ryusei-trigger-change-request / ryusei-trigger-list-reply / ryusei-trigger-list-request / gc-edit / gc-history / gc-member-add / gc-member-remove / gc-page / gc-read / gc-send / gc-send-result / hello / lagged / pane-frame / ping / pong / resync / stream-revoked / subscribe / subscribe-result / unsubscribe / welcome / wire-error / wire-gc-message

