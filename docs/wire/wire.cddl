; Bazaar wire payloads for the CBOR codec, protocol 1.0 (RFC 8610).
; Schema hash sha256:b5561bea42bd0aa7094cf4ce6deefccc6b7439ad01cf23acd598df9e6c558b3e.
; Map keys are text. Absent keys mean null or the default. Readers ignore unknown keys. Generated; do not edit.

envelope = {
  v: uint,
  t: tstr,
  k: "req" / "res" / "evt" / "err",
  ? id: tstr,
  ? re: tstr,
  ? s: tstr,
  ? n: int,
  ? ts: #6.0(tstr),
  ? p: any,
  * tstr => any
}

uuid-text = tstr .regexp "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
decimal-fraction = #6.4([exponent: int, mantissa: int])
float32-array = #6.85(bstr)

; Message types and the payload rule each carries.
; board.assign = kanban-assign-request
; board.snapshot = kanban-board-request
; engine.grant.verify = engine-grant-verify-request
; engine.relay.request = engine-relay-request-frame
; engine.relay.result = engine-relay-result-frame
; gc.edit = gc-edit
; gc.history = gc-history
; gc.list = gc-list-request
; gc.member.add = gc-member-add
; gc.member.remove = gc-member-remove
; gc.message = wire-gc-message
; gc.read = gc-read
; gc.send = gc-send
; graph.lod = graph-lod-frame
; hello = hello
; hive.grant.revoke = hive-grant-change-request
; hive.grant.set = hive-grant-change-request
; lagged = lagged
; pane.frame = pane-frame
; ping = ping
; pong = pong
; pr.hunks = pr-hunks-request
; pr.list = pr-list-request
; pr.merge = pr-merge-request
; pr.review = pr-review-request
; pr.summary = pr-summary-request
; presence.snapshot = presence-snapshot-request
; presence.update = presence-update
; resync = resync
; ryusei.trigger.list = ryusei-trigger-list-request
; ryusei.trigger.pause = ryusei-trigger-change-request
; ryusei.trigger.resume = ryusei-trigger-change-request
; stream.revoked = stream-revoked
; subscribe = subscribe
; unsubscribe = unsubscribe
; welcome = welcome

payload = engine-grant-verify-reply / engine-grant-verify-request / engine-relay-request-frame / engine-relay-result-frame / pr-hunks-reply / pr-hunks-request / pr-list-reply / pr-list-request / pr-merge-reply / pr-merge-request / pr-review-reply / pr-review-request / pr-summary-reply / pr-summary-request / cluster-glyph / focus-request / graph-lod-frame / graph-snapshot / layout-frame / tile-frame / tile-key / viewport-request / hive-grant-change-reply / hive-grant-change-request / kanban-assign-reply / kanban-assign-request / kanban-board-request / kanban-board-snapshot / release-manifest / roadmap-board-snapshot / ryusei-trigger-change-reply / ryusei-trigger-change-request / ryusei-trigger-list-reply / ryusei-trigger-list-request / gc-edit / gc-history / gc-list-item / gc-list-reply / gc-list-request / gc-member-add / gc-member-remove / gc-page / gc-read / gc-send / gc-send-result / hello / lagged / pane-frame / ping / pong / presence-snapshot / presence-snapshot-request / presence-typing / presence-update / resync / stream-revoked / subscribe / subscribe-result / unsubscribe / welcome / wire-error / wire-gc-message

