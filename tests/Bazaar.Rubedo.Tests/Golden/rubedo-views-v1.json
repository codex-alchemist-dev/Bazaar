{
  "schemaVersion": 1,
  "language": "rubedo-views",
  "description": "Golden view documents (doc 41c, section 8). Each case gives a JSON document and one expectation: codes (the exact ordered diagnostic codes, [] when valid) or readError (the JSON reader must refuse the shape).",
  "cases": [
    {
      "name": "minimal_valid_text",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "root": {
          "widget": "stack",
          "children": [
            {
              "widget": "text",
              "props": {
                "label": "Hello"
              }
            }
          ]
        }
      },
      "expect": {
        "codes": []
      }
    },
    {
      "name": "valid_with_data_expression_and_action",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.kodo.status",
        "data": {
          "unread": {
            "capability": "gc.feed",
            "type": "number"
          }
        },
        "actions": {
          "openFeed": {
            "kind": "navigate",
            "target": "gc/feed"
          }
        },
        "root": {
          "widget": "row",
          "children": [
            {
              "widget": "badge",
              "props": {
                "label": "Unread",
                "visibleWhen": {
                  "expr": "unread > 0"
                }
              }
            },
            {
              "widget": "button",
              "props": {
                "label": "Open",
                "action": "openFeed"
              }
            }
          ]
        }
      },
      "expect": {
        "codes": []
      }
    },
    {
      "name": "list_with_one_template",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.list",
        "root": {
          "widget": "list",
          "children": [
            {
              "widget": "text",
              "props": {
                "label": "Row"
              }
            }
          ]
        }
      },
      "expect": {
        "codes": []
      }
    },
    {
      "name": "tabs_and_grid_and_scroll_are_valid",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.layout.sample",
        "root": {
          "widget": "scroll",
          "children": [
            {
              "widget": "tabs",
              "children": [
                {
                  "widget": "grid",
                  "props": {
                    "columns": 2
                  },
                  "children": [
                    {
                      "widget": "divider"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "expect": {
        "codes": []
      }
    },
    {
      "name": "placeholder_is_a_valid_widget",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.fallback.card",
        "root": {
          "widget": "placeholder",
          "props": {
            "label": "Unavailable"
          }
        }
      },
      "expect": {
        "codes": []
      }
    },
    {
      "name": "unsupported_dsl_version",
      "document": {
        "dslVersion": 2,
        "name": "bazaar.gc.feed",
        "root": {
          "widget": "stack"
        }
      },
      "expect": {
        "codes": [
          "view.dsl_version"
        ]
      }
    },
    {
      "name": "name_with_upper_case",
      "document": {
        "dslVersion": 1,
        "name": "Bazaar.gc",
        "root": {
          "widget": "stack"
        }
      },
      "expect": {
        "codes": [
          "view.bad_name"
        ]
      }
    },
    {
      "name": "name_with_empty_segment",
      "document": {
        "dslVersion": 1,
        "name": "bazaar..gc",
        "root": {
          "widget": "stack"
        }
      },
      "expect": {
        "codes": [
          "view.bad_name"
        ]
      }
    },
    {
      "name": "name_single_segment_is_rejected",
      "document": {
        "dslVersion": 1,
        "name": "feed",
        "root": {
          "widget": "stack"
        }
      },
      "expect": {
        "codes": [
          "view.bad_name"
        ]
      }
    },
    {
      "name": "unknown_widget_stops_the_walk",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "root": {
          "widget": "carousel",
          "children": [
            {
              "widget": "button"
            }
          ]
        }
      },
      "expect": {
        "codes": [
          "view.unknown_widget"
        ]
      }
    },
    {
      "name": "button_without_label",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "root": {
          "widget": "button"
        }
      },
      "expect": {
        "codes": [
          "view.missing_label"
        ]
      }
    },
    {
      "name": "icon_with_empty_label",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "root": {
          "widget": "icon",
          "props": {
            "label": ""
          }
        }
      },
      "expect": {
        "codes": [
          "view.missing_label"
        ]
      }
    },
    {
      "name": "input_without_label",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "root": {
          "widget": "input"
        }
      },
      "expect": {
        "codes": [
          "view.missing_label"
        ]
      }
    },
    {
      "name": "button_points_at_undeclared_action",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "root": {
          "widget": "button",
          "props": {
            "label": "Go",
            "action": "missing"
          }
        }
      },
      "expect": {
        "codes": [
          "view.unknown_action"
        ]
      }
    },
    {
      "name": "button_action_must_be_a_string",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "root": {
          "widget": "button",
          "props": {
            "label": "Go",
            "action": 3
          }
        }
      },
      "expect": {
        "codes": [
          "view.unknown_action"
        ]
      }
    },
    {
      "name": "leaf_with_children",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "root": {
          "widget": "text",
          "props": {
            "label": "x"
          },
          "children": [
            {
              "widget": "divider"
            }
          ]
        }
      },
      "expect": {
        "codes": [
          "view.unexpected_children"
        ]
      }
    },
    {
      "name": "list_without_template",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.list",
        "root": {
          "widget": "list"
        }
      },
      "expect": {
        "codes": [
          "view.list_template"
        ]
      }
    },
    {
      "name": "list_with_two_templates",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.list",
        "root": {
          "widget": "list",
          "children": [
            {
              "widget": "text",
              "props": {
                "label": "a"
              }
            },
            {
              "widget": "text",
              "props": {
                "label": "b"
              }
            }
          ]
        }
      },
      "expect": {
        "codes": [
          "view.list_template"
        ]
      }
    },
    {
      "name": "data_name_with_hyphen",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "data": {
          "unread-count": {
            "capability": "gc.feed",
            "type": "number"
          }
        },
        "root": {
          "widget": "stack"
        }
      },
      "expect": {
        "codes": [
          "view.bad_data_name"
        ]
      }
    },
    {
      "name": "data_name_shadows_context",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "data": {
          "widthDp": {
            "capability": "gc.feed",
            "type": "number"
          }
        },
        "root": {
          "widget": "stack"
        }
      },
      "expect": {
        "codes": [
          "view.data_shadows_context"
        ]
      }
    },
    {
      "name": "visible_when_must_be_bool",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "data": {
          "unread": {
            "capability": "gc.feed",
            "type": "number"
          }
        },
        "root": {
          "widget": "text",
          "props": {
            "label": "x",
            "visibleWhen": {
              "expr": "unread + 1"
            }
          }
        }
      },
      "expect": {
        "codes": [
          "result-type"
        ]
      }
    },
    {
      "name": "enabled_when_must_be_bool",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "data": {
          "title": {
            "capability": "gc.feed",
            "type": "text"
          }
        },
        "root": {
          "widget": "button",
          "props": {
            "label": "Send",
            "enabledWhen": {
              "expr": "title"
            }
          }
        }
      },
      "expect": {
        "codes": [
          "result-type"
        ]
      }
    },
    {
      "name": "expression_uses_undeclared_name",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "root": {
          "widget": "text",
          "props": {
            "label": "x",
            "visibleWhen": {
              "expr": "secret > 0"
            }
          }
        }
      },
      "expect": {
        "codes": [
          "unknown-identifier"
        ]
      }
    },
    {
      "name": "expression_that_does_not_parse",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "root": {
          "widget": "text",
          "props": {
            "label": "x",
            "visibleWhen": {
              "expr": "((("
            }
          }
        }
      },
      "expect": {
        "codes": [
          "syntax"
        ]
      }
    },
    {
      "name": "several_problems_keep_walk_order",
      "document": {
        "dslVersion": 1,
        "name": "Bad",
        "root": {
          "widget": "stack",
          "children": [
            {
              "widget": "button"
            },
            {
              "widget": "nope"
            }
          ]
        }
      },
      "expect": {
        "codes": [
          "view.bad_name",
          "view.missing_label",
          "view.unknown_widget"
        ]
      }
    },
    {
      "name": "document_missing_root_is_a_read_error",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed"
      },
      "expect": {
        "readError": true
      }
    },
    {
      "name": "prop_that_is_an_object_without_expr",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "root": {
          "widget": "text",
          "props": {
            "label": {
              "text": "x"
            }
          }
        }
      },
      "expect": {
        "readError": true
      }
    },
    {
      "name": "unknown_data_type_is_a_read_error",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "data": {
          "x": {
            "capability": "gc.feed",
            "type": "list"
          }
        },
        "root": {
          "widget": "stack"
        }
      },
      "expect": {
        "readError": true
      }
    },
    {
      "name": "unknown_action_kind_is_a_read_error",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "actions": {
          "go": {
            "kind": "fetch"
          }
        },
        "root": {
          "widget": "stack"
        }
      },
      "expect": {
        "readError": true
      }
    }
  ]
}
