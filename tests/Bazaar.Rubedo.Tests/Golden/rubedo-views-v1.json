{
  "schemaVersion": 1,
  "language": "rubedo-views",
  "description": "Golden view documents (list item scope included) (doc 41c, section 8). Each case gives a JSON document and one expectation: codes (the exact ordered diagnostic codes, [] when valid) or readError (the JSON reader must refuse the shape).",
  "cases": [
    {
      "name": "minimal_valid_text",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.gc.feed",
        "root": {
          "widget": "stack",
          "children": [
            {
              "widget": "text",
              "props": {
                "label": "Hello"
              }
            }
          ]
        }
      },
      "expect": {
        "codes": []
      }
    },
    {
      "name": "valid_with_data_expression_and_action",
      "document": {
        "dslVersion": 1,
        "name": "bazaar.kodo.status",
        "data": {
          "unread": {
            "capability": "gc.feed",
            "type": "number"
          }
        },
        "actions": {
          "openFeed": {
            "kind": "navigate",
            "target": "gc/feed"
          }
        },
        "root": {
          "widget": "row",
          "children": [
            {
              "widget": "badge",
              "props": {
                "label": "Unread",
                "visibleWhen": {
                  "expr": "unread > 0"
                }
              }
            },
            {
              "widget": "button",
              "props": {
                "label": "Open",
                "action": "openFeed"
              }
            }
          ]
        }
      },
      "expect": {
        "codes": []
      }
    },
