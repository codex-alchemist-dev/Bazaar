{
  "dslVersion": 1,
  "name": "bazaar.gc.feed",
  "data": {
    "unreadGcs": { "capability": "gc.feed", "type": "number" },
    "mentions": { "capability": "gc.feed", "type": "number" },
    "gcs": {
      "capability": "gc.feed",
      "type": "list",
      "fields": { "id": "text", "name": "text", "unread": "number", "mentioned": "bool" }
    }
  },
  "actions": {
    "openChats": { "kind": "navigate", "target": "gc" }
  },
  "root": {
    "widget": "stack",
    "children": [
      {
        "widget": "row",
        "children": [
          { "widget": "text", "props": { "text": "Unread chats" } },
          { "widget": "text", "props": { "text": { "expr": "unreadGcs" } } },
          { "widget": "badge", "props": { "text": { "expr": "mentions" }, "variant": "owner", "visibleWhen": { "expr": "mentions > 0" } } },
          { "widget": "button", "props": { "label": "Open chats", "action": "openChats" } }
        ]
      },
      {
        "widget": "list",
        "props": { "over": "gcs", "key": "id" },
        "children": [
          {
            "widget": "row",
            "children": [
              { "widget": "text", "props": { "text": { "expr": "name" } } },
              { "widget": "badge", "props": { "text": { "expr": "unread" }, "variant": "neutral", "visibleWhen": { "expr": "unread > 0" } } },
              { "widget": "badge", "props": { "text": "@", "variant": "owner", "visibleWhen": { "expr": "mentioned" } } }
            ]
          }
        ]
      }
    ]
  }
}
