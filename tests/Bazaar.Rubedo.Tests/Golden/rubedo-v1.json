{
  "schemaVersion": 1,
  "language": "rubedo",
  "cases": [
    { "name": "literal true", "source": "true", "context": {}, "expect": { "value": true } },
    { "name": "decimal sum is exact", "source": "0.1 + 0.2 == 0.3", "context": {}, "expect": { "value": true } },
    { "name": "precedence of product over sum", "source": "2 + 3 * 4 == 14", "context": {}, "expect": { "value": true } },
    { "name": "parentheses override precedence", "source": "(2 + 3) * 4 == 20", "context": {}, "expect": { "value": true } },
    { "name": "modulo", "source": "17 % 5 == 2", "context": {}, "expect": { "value": true } },
    { "name": "unary minus", "source": "-3 + 5 == 2", "context": {}, "expect": { "value": true } },
    { "name": "negation of bool", "source": "!reduceMotion", "context": { "reduceMotion": false }, "expect": { "value": true } },
    { "name": "width threshold half-open 600", "source": "widthDp >= 600", "context": { "widthDp": 600 }, "expect": { "value": true } },
    { "name": "width below threshold", "source": "widthDp >= 600", "context": { "widthDp": 599.5 }, "expect": { "value": false } },
    { "name": "phone and folded", "source": "deviceClass == \"phone\" && posture == \"folded\"", "context": { "deviceClass": "phone", "posture": "folded" }, "expect": { "value": true } },
    { "name": "or short circuits past a missing value", "source": "true || isOwner", "context": {}, "expect": { "value": true } },
    { "name": "and short circuits past a missing value", "source": "false && isOwner", "context": {}, "expect": { "value": false } },
    { "name": "min", "source": "min(3, 7) == 3", "context": {}, "expect": { "value": true } },
    { "name": "max", "source": "max(3, 7) == 7", "context": {}, "expect": { "value": true } },
    { "name": "abs", "source": "abs(-4) == 4", "context": {}, "expect": { "value": true } },
    { "name": "clamp inside range", "source": "clamp(5, 0, 10) == 5", "context": {}, "expect": { "value": true } },
    { "name": "clamp below range", "source": "clamp(-5, 0, 10) == 0", "context": {}, "expect": { "value": true } },
    { "name": "clamp with lo above hi", "source": "clamp(5, 10, 0) == 5", "context": {}, "expect": { "error": "bad-range" } },
    { "name": "contains", "source": "contains(\"bazaar.gc\", \"gc\")", "context": {}, "expect": { "value": true } },
    { "name": "startsWith", "source": "startsWith(deviceClass, \"fold\")", "context": { "deviceClass": "foldable" }, "expect": { "value": true } },
    { "name": "inSet with strings", "source": "inSet(display, \"cover\", \"inner\")", "context": { "display": "inner" }, "expect": { "value": true } },
    { "name": "inSet with numbers misses", "source": "inSet(widthDp, 600, 840)", "context": { "widthDp": 700 }, "expect": { "value": false } },
    { "name": "division by zero", "source": "1 / 0 == 0", "context": {}, "expect": { "error": "division-by-zero" } },
    { "name": "modulo by zero", "source": "1 % 0 == 0", "context": {}, "expect": { "error": "division-by-zero" } },
    { "name": "missing context value", "source": "widthDp > 0", "context": {}, "expect": { "error": "missing-value" } },
    { "name": "result outside magnitude", "source": "1000000000000000 * 10 > 0", "context": {}, "expect": { "error": "number-out-of-range" } },
    { "name": "unknown identifier", "source": "widht > 0", "context": {}, "expect": { "compileError": "unknown-identifier" } },
    { "name": "unknown function", "source": "sqrt(4) == 2", "context": {}, "expect": { "compileError": "unknown-function" } },
    { "name": "wrong argument type", "source": "min(\"a\", 2) == 2", "context": {}, "expect": { "compileError": "type" } },
    { "name": "arity", "source": "abs(1, 2) == 2", "context": {}, "expect": { "compileError": "arity" } },
    { "name": "equality across types", "source": "widthDp == \"600\"", "context": { "widthDp": 600 }, "expect": { "compileError": "type" } },
    { "name": "chained comparison", "source": "1 < 2 < 3", "context": {}, "expect": { "compileError": "chained-comparison" } },
    { "name": "bool arithmetic", "source": "true + 1 == 2", "context": {}, "expect": { "compileError": "type" } },
    { "name": "string over the limit", "source": "\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" == \"\"", "context": {}, "expect": { "compileError": "string-too-long" } },
    { "name": "unterminated string", "source": "\"abc", "context": {}, "expect": { "compileError": "unterminated-string" } },
    { "name": "escape is rejected", "source": "\"a\\b\" == \"\"", "context": {}, "expect": { "compileError": "bad-string" } },
    { "name": "bad character", "source": "1 @ 2", "context": {}, "expect": { "compileError": "bad-character" } },
    { "name": "trailing text", "source": "true false", "context": {}, "expect": { "compileError": "syntax" } },
    { "name": "unclosed parenthesis", "source": "(1 + 2 == 3", "context": {}, "expect": { "compileError": "syntax" } },
    { "name": "number out of range literal", "source": "10000000000000000 > 0", "context": {}, "expect": { "compileError": "number-out-of-range" } },
    { "name": "decimal point needs digits", "source": "1. == 1", "context": {}, "expect": { "compileError": "bad-number" } },
    { "name": "context type mismatch", "source": "widthDp > 0", "context": { "widthDp": "600" }, "expect": { "contextError": "context-type" } }
  ]
}
