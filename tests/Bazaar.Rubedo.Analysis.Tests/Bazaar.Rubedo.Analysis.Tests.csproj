<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <!-- The golden corpora are owned by Bazaar.Rubedo.Tests; the fuzz tests read the same files. -->
    <None Include="..\Bazaar.Rubedo.Tests\Golden\**\*.json" Link="Golden\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bazaar.Rubedo.Analysis\Bazaar.Rubedo.Analysis.csproj" />
  </ItemGroup>
</Project>
