<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The store is an in-memory fake and the Postgres tests are short; test cancellation tokens add nothing. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bazaar.Server\Bazaar.Server.csproj" />
    <ProjectReference Include="..\..\src\Bazaar.Server.ApprovalQueue\Bazaar.Server.ApprovalQueue.csproj" />
    <ProjectReference Include="..\..\src\Bazaar.Server.ApprovalQueue.Abstractions\Bazaar.Server.ApprovalQueue.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Bazaar.Testing\Bazaar.Testing.csproj" />
  </ItemGroup>
</Project>
