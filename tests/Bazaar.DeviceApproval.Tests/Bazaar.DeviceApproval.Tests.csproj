<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <!-- The TPM signer is CNG-only. Off Windows its tests are not compiled, so the Linux runners run the gate tests only. -->
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="TpmApprovalSignerTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bazaar.DeviceApproval.Abstractions\Bazaar.DeviceApproval.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Bazaar.DeviceApproval.Windows\Bazaar.DeviceApproval.Windows.csproj" />
  </ItemGroup>
</Project>
