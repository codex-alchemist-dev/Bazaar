<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Interrupt migrations stay in Bazaar.Server (Data/Sql). The DB tests run the same two scripts directly, in order. -->
    <EmbeddedResource Include="..\..\src\Bazaar.Server\Data\Sql\common\0015_interrupt_frame.sql" LogicalName="interrupt_0015.sql" />
    <EmbeddedResource Include="..\..\src\Bazaar.Server\Data\Sql\interrupts\0001_interrupt_reason_sealed.sql" LogicalName="interrupt_0001.sql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bazaar.Server.Interrupts\Bazaar.Server.Interrupts.csproj" />
    <ProjectReference Include="..\..\src\Bazaar.Testing\Bazaar.Testing.csproj" />
  </ItemGroup>
</Project>
