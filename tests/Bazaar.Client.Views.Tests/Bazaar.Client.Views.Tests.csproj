<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared pilot view documents: the same files the Rubedo tests validate, rendered here through the real mapper. -->
    <None Include="..\Bazaar.Rubedo.Tests\Golden\pilots\*.json" Link="Golden\pilots\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bazaar.Client.Theme\Bazaar.Client.Theme.csproj" />
    <ProjectReference Include="..\..\src\Bazaar.Client.Views\Bazaar.Client.Views.csproj" />
    <ProjectReference Include="..\..\src\Bazaar.Client.RyuseiFuda\Bazaar.Client.RyuseiFuda.csproj" />
  </ItemGroup>
</Project>
