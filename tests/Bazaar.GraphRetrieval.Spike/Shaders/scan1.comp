#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 256) in;
#include "select.glsl"
shared uint partial[256];
// One workgroup per query: finds the bin b1 (counting from the top) where the cumulative count first reaches kPrime.
void main()
{
    uint q = gl_WorkGroupID.x;
    uint t = gl_LocalInvocationID.x;
    uint base = 4095u - t * 16u;           // this thread covers bins base, base-1, ..., base-15 (descending)
    uint c[16];
    uint sum = 0u;
    for (uint i = 0u; i < 16u; i++) { c[i] = hist1[q * 4096u + base - i]; sum += c[i]; }
    partial[t] = sum;
    barrier();
    for (uint step = 1u; step < 256u; step <<= 1u)
    {
        uint add = t >= step ? partial[t - step] : 0u;
        barrier();
        partial[t] += add;
        barrier();
    }
    uint before = partial[t] - sum;
    if (before < p.kPrime && before + sum >= p.kPrime)
    {
        uint cum = before;
        for (uint i = 0u; i < 16u; i++)
        {
            if (cum + c[i] >= p.kPrime)
            {
                params[q * 4u + 0u] = base - i;
                params[q * 4u + 1u] = cum;
                params[q * 4u + 3u] = 0u;
                return;
            }
            cum += c[i];
        }
    }
    if (t == 255u && partial[255] < p.kPrime)
    {
        params[q * 4u + 0u] = 0u;
        params[q * 4u + 1u] = partial[255];
        params[q * 4u + 2u] = 0u;
        params[q * 4u + 3u] = 1u;
    }
}
