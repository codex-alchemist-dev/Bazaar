#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 1) in;
#include "graph.glsl"
void main()
{
    uint end = state[1];
    uint cnt = min(state[2], p.cap);
    state[0] = end;
    state[1] = cnt;
    state[3] = ((cnt - end) + 255u) / 256u;
    state[4] = 1u;
    state[5] = 1u;
    state[8u + p.level + 1u] = cnt;
}
