#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 256) in;
#include "select.glsl"
shared uint partial[256];
// Second level: within bin b1, finds the 12-bit sub-bin where the remaining count is reached; writes the threshold key.
void main()
{
    uint q = gl_WorkGroupID.x;
    uint t = gl_LocalInvocationID.x;
    if (params[q * 4u + 3u] != 0u) { return; }
    uint need = p.kPrime - params[q * 4u + 1u];
    uint b1 = params[q * 4u + 0u];
    uint base = 4095u - t * 16u;
    uint c[16];
    uint sum = 0u;
    for (uint i = 0u; i < 16u; i++) { c[i] = hist2[q * 4096u + base - i]; sum += c[i]; }
    partial[t] = sum;
    barrier();
    for (uint step = 1u; step < 256u; step <<= 1u)
    {
        uint add = t >= step ? partial[t - step] : 0u;
        barrier();
        partial[t] += add;
        barrier();
    }
    uint before = partial[t] - sum;
    if (before < need && before + sum >= need)
    {
        uint cum = before;
        for (uint i = 0u; i < 16u; i++)
        {
            if (cum + c[i] >= need)
            {
                params[q * 4u + 2u] = (b1 << 20) | ((base - i) << 8);
                return;
            }
            cum += c[i];
        }
    }
    if (t == 255u && partial[255] < need) { params[q * 4u + 2u] = b1 << 20; }
}
