<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared gateway test support (harness, fakes, policy world). Not a test project: no test runner. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <!-- The support types stay internal; only the gateway and agent test assemblies see them. -->
    <InternalsVisibleTo Include="Bazaar.Server.Gateway.Tests" />
    <InternalsVisibleTo Include="Bazaar.Server.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bazaar.Contracts\Bazaar.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Bazaar.Server.Gateway\Bazaar.Server.Gateway.csproj" />
    <ProjectReference Include="..\..\src\Bazaar.Server.Gateway.Abstractions\Bazaar.Server.Gateway.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Bazaar.Testing\Bazaar.Testing.csproj" />
  </ItemGroup>
</Project>
