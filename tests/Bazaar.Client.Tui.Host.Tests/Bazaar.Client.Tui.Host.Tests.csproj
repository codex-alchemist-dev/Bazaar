<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Matches the other test projects that call ports with their default token. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Bazaar.Client.Tui.Tests\ScriptedTerminal.cs" Link="ScriptedTerminal.cs" />
    <Compile Include="..\Bazaar.Roles.Tests\InMemoryRoleStore.cs" Link="InMemoryRoleStore.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bazaar.Client.Tui.Host\Bazaar.Client.Tui.Host.csproj" />
  </ItemGroup>
</Project>
