#version 450
#extension GL_GOOGLE_include_directive : require
// Point decimation, pass 1: each sampled point claims its 2x2-pixel screen cell. The highest instance index wins.
// a = cells per row (640), b = number of sampled points. Cells buffer is binding 1 (cleared to 0 each frame).
#include "topology.glsl"
layout(local_size_x = 256) in;
layout(set = 0, binding = 1) buffer Cells { uint cells[]; };
void main()
{
    uint k = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    if (k >= pc.b) { return; }
    vec4 clip = pc.viewProj * vec4(nodePos(min(k * pc.stride, pc.n - 1u)), 1.0);
    if (clip.w <= 0.0) { return; }
    vec2 ndc = clip.xy / clip.w;
    if (abs(ndc.x) >= 1.0 || abs(ndc.y) >= 1.0) { return; }
    uint x = uint((ndc.x * 0.5 + 0.5) * float(pc.a));
    uint y = uint((ndc.y * 0.5 + 0.5) * 360.0);
    atomicMax(cells[y * pc.a + x], k + 1u);
}
