#version 450
#extension GL_GOOGLE_include_directive : require
// Point decimation, pass 2: the winner of each cell appends itself to the survivor list behind a draw-indirect header.
// Buffer binding 2: words 0..3 are VkDrawIndirectCommand (vertexCount 1, instanceCount = counter), survivors start at word 8.
#include "topology.glsl"
layout(local_size_x = 256) in;
layout(set = 0, binding = 1) readonly buffer Cells { uint cells[]; };
layout(set = 0, binding = 2) buffer Survivors { uint words[]; };
void main()
{
    uint k = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    if (k >= pc.b) { return; }
    vec4 clip = pc.viewProj * vec4(nodePos(min(k * pc.stride, pc.n - 1u)), 1.0);
    if (clip.w <= 0.0) { return; }
    vec2 ndc = clip.xy / clip.w;
    if (abs(ndc.x) >= 1.0 || abs(ndc.y) >= 1.0) { return; }
    uint x = uint((ndc.x * 0.5 + 0.5) * float(pc.a));
    uint y = uint((ndc.y * 0.5 + 0.5) * 360.0);
    if (cells[y * pc.a + x] == k + 1u)
    {
        uint slot = atomicAdd(words[1], 1u);
        words[8u + slot] = k;
    }
}
