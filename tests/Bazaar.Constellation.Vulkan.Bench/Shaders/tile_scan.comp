#version 450
#extension GL_GOOGLE_include_directive : require
// Tile build, pass 2: exclusive prefix sum of the tile counts (one workgroup, 4 tiles per thread).
#include "topology.glsl"
#include "tile.glsl"
layout(local_size_x = 1024) in;
shared uint partial[1024];
void main()
{
    uint tid = gl_LocalInvocationID.x;
    uint c0 = tileCount[tid * 4u + 0u], c1 = tileCount[tid * 4u + 1u], c2 = tileCount[tid * 4u + 2u], c3 = tileCount[tid * 4u + 3u];
    uint sum = c0 + c1 + c2 + c3;
    partial[tid] = sum;
    barrier();
    for (uint step = 1u; step < 1024u; step <<= 1u)
    {
        uint add = tid >= step ? partial[tid - step] : 0u;
        barrier();
        partial[tid] += add;
        barrier();
    }
    uint start = partial[tid] - sum;
    uint o0 = start, o1 = o0 + c0, o2 = o1 + c1, o3 = o2 + c2;
    tileOffset[tid * 4u + 0u] = o0; tileCursor[tid * 4u + 0u] = o0;
    tileOffset[tid * 4u + 1u] = o1; tileCursor[tid * 4u + 1u] = o1;
    tileOffset[tid * 4u + 2u] = o2; tileCursor[tid * 4u + 2u] = o2;
    tileOffset[tid * 4u + 3u] = o3; tileCursor[tid * 4u + 3u] = o3;
}
