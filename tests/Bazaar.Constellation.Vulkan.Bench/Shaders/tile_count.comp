#version 450
#extension GL_GOOGLE_include_directive : require
// Tile build, pass 1: count the sampled points per tile and grow each tile's bounds. b = sampled points, stride = index step.
#include "topology.glsl"
#include "tile.glsl"
layout(local_size_x = 256) in;
void main()
{
    uint k = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    if (k >= pc.b) { return; }
    vec3 p = nodePos(min(k * pc.stride, pc.n - 1u));
    uint t = tileOf(p);
    atomicAdd(tileCount[t], 1u);
    atomicMin(tileBounds[t * 6u + 0u], fkey(p.x));
    atomicMin(tileBounds[t * 6u + 1u], fkey(p.y));
    atomicMin(tileBounds[t * 6u + 2u], fkey(p.z));
    atomicMax(tileBounds[t * 6u + 3u], fkey(p.x));
    atomicMax(tileBounds[t * 6u + 4u], fkey(p.y));
    atomicMax(tileBounds[t * 6u + 5u], fkey(p.z));
}
