#version 450
#extension GL_GOOGLE_include_directive : require
// Tile build, pass 3: write each sample index into its tile's slice of the sorted list.
#include "topology.glsl"
#include "tile.glsl"
layout(local_size_x = 256) in;
void main()
{
    uint k = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    if (k >= pc.b) { return; }
    uint t = tileOf(nodePos(min(k * pc.stride, pc.n - 1u)));
    sorted[atomicAdd(tileCursor[t], 1u)] = k;
}
