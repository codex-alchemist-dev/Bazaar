#version 450
#extension GL_GOOGLE_include_directive : require
// Hi-Z pyramid, levels 1 and up: each texel is the min of the 2x2 texels below it (edge clamped).
// Push reuse: a = source offset, b = destination offset, c = destination width, stride = destination height, topo = source width, dim = source height.
#include "topology.glsl"
#include "tile.glsl"
layout(local_size_x = 256) in;
void main()
{
    uint k = gl_GlobalInvocationID.x;
    uint w = pc.c, h = pc.stride;
    if (k >= w * h) { return; }
    uint x = k % w, y = k / w;
    uint x0 = min(x * 2u, pc.topo - 1u), y0 = min(y * 2u, pc.dim - 1u);
    uint x1 = min(x * 2u + 1u, pc.topo - 1u), y1 = min(y * 2u + 1u, pc.dim - 1u);
    hiz[pc.b + k] = min(min(hiz[pc.a + y0 * pc.topo + x0], hiz[pc.a + y0 * pc.topo + x1]), min(hiz[pc.a + y1 * pc.topo + x0], hiz[pc.a + y1 * pc.topo + x1]));
}
