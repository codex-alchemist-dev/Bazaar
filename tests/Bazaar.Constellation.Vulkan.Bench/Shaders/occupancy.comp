#version 450
#extension GL_GOOGLE_include_directive : require
// Counts the non-empty cells of the screen grid into word 4 of the survivors buffer (the estimate of covered pixels).
#include "topology.glsl"
layout(local_size_x = 256) in;
layout(set = 0, binding = 1) readonly buffer Screen { uint screen[]; };
layout(set = 0, binding = 2) buffer Counter { uint words[]; };
void main()
{
    uint i = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    if (i >= pc.b) { return; }
    if (screen[i] != 0u) { atomicAdd(words[4], 1u); }
}
