#version 450
#extension GL_GOOGLE_include_directive : require
// Build-time edge bundling: each sampled edge adds 32 points along its length to the aggregate voxel grid, so the
// per-frame aggregate pass shows the edges as density with no line drawing. a = first edge, b = edge count, c = g.
#include "topology.glsl"
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) buffer Voxels { uint voxels[]; };
void main()
{
    uint local = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    if (local >= pc.b) { return; }
    uint i = min((pc.a + local) * pc.stride, pc.n - 1u);
    vec3 p0 = nodePos(i);
    vec3 p1 = nodePos(partner(i));
    uint g = pc.c;
    for (uint s = 0u; s < 32u; s++)
    {
        vec3 p = mix(p0, p1, (float(s) + 0.5) / 32.0) * 0.5 + 0.5;
        uvec3 v = uvec3(clamp(p * float(g), vec3(0.0), vec3(float(g - 1u))));
        uint index = pc.dim == 2u ? v.y * g + v.x : (v.z * g + v.y) * g + v.x;
        atomicAdd(voxels[index], 1u);
    }
}
