#version 450
#extension GL_GOOGLE_include_directive : require
// Per-frame aggregate splat: each non-empty voxel is projected and adds its count to the screen grid.
// c = g (voxels per axis), a = total voxel count, b = screen grid width.
#include "topology.glsl"
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Voxels { uint voxels[]; };
layout(set = 0, binding = 1) buffer Screen { uint screen[]; };
void main()
{
    uint index = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    if (index >= pc.a) { return; }
    uint count = voxels[index];
    if (count == 0u) { return; }
    uint g = pc.c;
    uvec3 v = pc.dim == 2u ? uvec3(index % g, index / g, 0u) : uvec3(index % g, (index / g) % g, index / (g * g));
    vec3 p = ((vec3(v) + 0.5) / float(g)) * 2.0 - 1.0;
    if (pc.dim == 2u) { p.z = 0.0; }
    vec4 clip = pc.viewProj * vec4(p, 1.0);
    if (clip.w <= 0.0) { return; }
    vec2 ndc = clip.xy / clip.w;
    if (abs(ndc.x) >= 1.0 || abs(ndc.y) >= 1.0) { return; }
    uint x = uint((ndc.x * 0.5 + 0.5) * float(pc.b));
    uint y = uint((ndc.y * 0.5 + 0.5) * 720.0);
    atomicAdd(screen[y * pc.b + x], count);
}
