<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Every wait in these tests is bounded by WithinAsync, and the stream calls are on in-memory or loopback pipes, so the test token adds nothing. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bazaar.Server.VmTransport\Bazaar.Server.VmTransport.csproj" />
    <ProjectReference Include="..\..\src\Bazaar.Server.VmTransport.Abstractions\Bazaar.Server.VmTransport.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Bazaar.Guest.Agent\Bazaar.Guest.Agent.csproj" />
    <ProjectReference Include="..\..\src\Bazaar.Contracts\Bazaar.Contracts.csproj" />
  </ItemGroup>
</Project>
